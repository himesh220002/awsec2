# Server Configuration
PORT=8080

# Twitch API
TWITCH_CLIENT_ID=your_twitch_client_id_here
TWITCH_CLIENT_SECRET=your_twitch_client_secret_here

# Video Admin Dashboard & Safeguard PIN
VIDEO_ADMIN_PASSWORD=your_secure_admin_password
ADMIN_PASSWORD=your_secure_admin_password

# Discord Operations Webhook
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_id/your_webhook_token

# AWS S3 (Programmatic Credentials - ap-south-1)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=ap-south-1
AWS_S3_BUCKET=your_s3_bucket_name

# Amazon CloudFront CDN Domain
CLOUDFRONT_DOMAIN=stream.cyphertech.online

# MongoDB Atlas Cluster URI
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/igvDB?retryWrites=true&w=majority
